# ============================================================
#  Hebrew Pronunciation Coach — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ---- Google Cloud Text-to-Speech ----
# Choose ONE authentication method:

# Option A — API Key (easiest for personal/dev use)
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an API key and restrict it to the Cloud Text-to-Speech API
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Option B — Service Account JSON (recommended for production)
#   1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
#   2. Create a service account, grant "Cloud Text-to-Speech User" role
#   3. Download the JSON key file and set the path below
#   If this is set, it takes priority over GOOGLE_TTS_API_KEY.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json


# ---- Azure Cognitive Services — Speech ----
#   1. Go to https://portal.azure.com
#   2. Create a "Speech" resource (free tier F0 available)
#   3. Copy the key and region from the "Keys and Endpoint" page
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=westeurope   # closest region to Israel; change if you create elsewhere


# ---- CORS ----
#   Comma-separated list of allowed frontend origins.
#   For local dev the Vite default is http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#   Add your Render frontend URL before deploying, e.g.:
# ALLOWED_ORIGINS=https://hebrew-coach-frontend.onrender.com,http://localhost:5173
